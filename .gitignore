# ---- Gradle ----
.gradle/
build/
# keep the wrapper (jar files are otherwise easy to ignore by accident)
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
gradle-app.setting
.gradletasknamecache

# ---- Kotlin (2.x compiler / daemon session data) ----
.kotlin/

# ---- IntelliJ IDEA ----
# ignore everything except shared code style and run configurations
.idea/*
!.idea/codeStyles/
!.idea/runConfigurations/
*.iml
*.ipr
*.iws
out/

# ---- AI assistants (local state; shared guidelines stay tracked) ----
.junie/plans/
.claude/settings.local.json

# ---- Eclipse / VS Code ----
.project
.classpath
.settings/
/bin/
.vscode/

# ---- Local test servers (e.g. run-paper), at the repository root only ----
/run/
/server/

# ---- OS / misc ----
.DS_Store
Thumbs.db
desktop.ini
*.log
*.hprof
